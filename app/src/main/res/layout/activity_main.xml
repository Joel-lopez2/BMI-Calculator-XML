<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E17"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- HEADER CON POKEBALL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_pokeball" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_title"
                    android:textColor="#FFCC00"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_pokeball" />

            </LinearLayout>


            <!-- SUBTÍTOL -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="22dp"
                android:gravity="center"
                android:text="@string/tv_subtitle"
                android:textColor="#A0A5C0"
                android:textSize="15sp" />


            <!-- CARD ENTRENADOR / NOM -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#161A2B"
                app:cardCornerRadius="20dp"
                app:strokeColor="#3B4CCA"
                app:strokeWidth="2dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_name"
                        android:textColor="#FFCC00"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxBackgroundColor="#21263E"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#FFCC00"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:hint="@string/et_name"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:paddingHorizontal="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#7078A0"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- CARD ALÇADA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#161A2B"
                app:cardCornerRadius="20dp"
                app:strokeColor="#3B4CCA"
                app:strokeWidth="2dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALÇADA"
                        android:textColor="#FFCC00"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tv_height"
                            android:textColor="#FFFFFF"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="5dp"
                            android:text="cm"
                            android:textColor="#FFCC00"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"

                        android:value="186"
                        android:valueFrom="120"
                        android:valueTo="220"
                        android:stepSize="1"

                        app:haloColor="#33FFCC00"
                        app:thumbColor="#FFCC00"
                        app:trackColorActive="#FFCC00"
                        app:trackColorInactive="#3B4CCA" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="120 cm"
                            android:textColor="#7078A0"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="220 cm"
                            android:textColor="#7078A0"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- CARD PES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#161A2B"
                app:cardCornerRadius="20dp"
                app:strokeColor="#3B4CCA"
                app:strokeWidth="2dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PES"
                            android:textColor="#FFCC00"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_weight"
                                android:textColor="#FFFFFF"
                                android:textSize="38sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginBottom="5dp"
                                android:text="kg"
                                android:textColor="#FFCC00"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinus"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="10dp"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:padding="0dp"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#CC0000"
                        app:cornerRadius="27dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlus"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:padding="0dp"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#3B4CCA"
                        app:cornerRadius="27dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- BOTÓ CALCULAR CARTA POKÉMON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/btn_calculate"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_pokeball"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="24dp"
                app:iconTint="@null"
                app:backgroundTint="#FFCC00"
                app:cornerRadius="18dp" />


            <!-- CARTA POKÉMON RESULTAT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFCA28"
                app:strokeColor="#FF8F00"
                app:strokeWidth="4dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:id="@+id/layoutCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="#151D2A">

                    <!-- HEADER DE LA CARTA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvPokemonStage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BÁSICO"
                            android:textColor="#FFD54F"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPokemonName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="MAGIKARP"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPokemonHP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 HP"
                            android:textColor="#FF5252"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivTypeIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_water_energy" />

                    </LinearLayout>


                    <!-- MARCA D'IL·LUSTRACIÓ POKÉMON -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pokemon_art_frame"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivPokemonArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_magikarp" />

                        <TextView
                            android:id="@+id/tvTrainerTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:background="#CC000000"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Entrenador: Ash"
                            android:textColor="#FFD54F"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRarityBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:background="#E6FFD700"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="★ RARA SHINY"
                            android:textColor="#000000"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </FrameLayout>


                    <!-- BARRA D'INFORMACIÓ POKÉMON -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#2A2A3C"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvPokemonInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nº 129 Pokémon Pez  |  Alt: 0.9m  |  Peso: 10.0kg"
                            android:textColor="#D1C4E9"
                            android:textSize="11sp"
                            android:textStyle="italic" />

                    </LinearLayout>


                    <!-- SECCIÓ RESULTAT IMC / ATAC POKÉMON -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:background="#1E1E2E"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivMoveEnergy1"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_water_energy" />

                            <ImageView
                                android:id="@+id/ivMoveEnergy2"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_water_energy" />

                            <TextView
                                android:id="@+id/tvMoveName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Salpicadura / Splash"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBMIDamage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IMC: 17.2"
                                android:textColor="#FFD54F"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- ETIQUETA ESTAT IMC -->
                        <TextView
                            android:id="@+id/tvBMIStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#17345C"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="● BAIX PES"
                            android:textColor="#6EA8FE"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- DESCRIPCIÓ DE L'ATAC -->
                        <TextView
                            android:id="@+id/tvMoveDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="¡Salpicadura sin efecto! El teu índex de massa corporal és baix. ¡Magikarp necessita menjar més per evolucionar!"
                            android:textColor="#E0E0E0"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <!-- PEU DE CARTA POKÉMON -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="debilidad ⚡×2  |  resistencia ─"
                            android:textColor="#9E9E9E"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvCardFooter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="001/151 ◆ Carta BMI"
                            android:textColor="#FFD54F"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- AVÍS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="ⓘ L’IMC és una referència orientativa, no un diagnòstic mèdic."
                android:textColor="#7078A0"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>